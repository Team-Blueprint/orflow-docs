{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "Orflow",
  "colors": {
    "primary": "#f97316",
    "light": "#f97316",
    "dark": "#ea580c"
  },
  "favicon": "/favicon.svg",
    "appearance": {
    "default": "dark"
  },
  "variables": {
    "API_BASE_URL": "https://orflow-backend.onrender.com",
    "DASHBOARD_URL": "https://orflow.vercel.app",
    "SITE_URL": "https://orflow.vercel.app"
  },
  "fonts": {
    "family": "Manrope"
  },
  "icons": {
    "library": "tabler"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "dark": "#09090b",
      "light": "#ffffff"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "pages": [
          {
            "group": "Getting Started",
            "pages": ["index", "quickstart", "environment-setup"]
          },
          {
            "group": "Core Concepts",
            "pages": ["core-concepts/tenants-projects", "core-concepts/authentication", "core-concepts/sandbox-vs-live"]
          },
          {
            "group": "Guides",
            "pages": ["guides/getting-started", "guides/subscription-pages", "guides/self-service-portal", "guides/handling-webhooks", "guides/subscription-lifecycle"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "pages": [
          {
            "group": "Authentication",
            "pages": [
              "api-reference/authentication/index",
              {
                "group": "API Keys",
                "pages": [
                  "api-reference/authentication/keys/new",
                  "api-reference/authentication/keys/create",
                  "api-reference/authentication/keys/regenerate",
                  "api-reference/authentication/keys/revoke"
                ]
              }
            ]
          },
          {
            "group": "Plans",
            "pages": [
              "api-reference/plans/index",
              "api-reference/plans/create",
              "api-reference/plans/list",
              "api-reference/plans/get",
              "api-reference/plans/update",
              "api-reference/plans/archive"
            ]
          },
          {
            "group": "Customers",
            "pages": [
              "api-reference/customers/index",
              "api-reference/customers/create",
              "api-reference/customers/all",
              "api-reference/customers/get",
              "api-reference/customers/update",
              "api-reference/customers/delete"
            ]
          },
          {
            "group": "Subscriptions",
            "pages": [
              "api-reference/subscriptions/index",
              "api-reference/subscriptions/create",
              "api-reference/subscriptions/cancel",
              "api-reference/subscriptions/pause",
              "api-reference/subscriptions/resume",
              "api-reference/subscriptions/change-plan",
              "api-reference/subscriptions/audit-log"
            ]
          },
          {
            "group": "Subscription Pages",
            "pages": [
              "api-reference/subscription-pages/index",
              "api-reference/subscription-pages/create",
              "api-reference/subscription-pages/list",
              "api-reference/subscription-pages/get",
              "api-reference/subscription-pages/update",
              "api-reference/subscription-pages/delete"
            ]
          },
          {
            "group": "Payment Methods",
            "pages": [
              "api-reference/payment-methods/index",
              "api-reference/payment-methods/create",
              "api-reference/payment-methods/customer",
              "api-reference/payment-methods/get",
              "api-reference/payment-methods/update",
              "api-reference/payment-methods/set-default",
              "api-reference/payment-methods/delete"
            ]
          },
          {
            "group": "Payments",
            "pages": [
              "api-reference/payments/index",
              "api-reference/payments/verify",
              "api-reference/payments/status"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "api-reference/webhooks/index",
              "api-reference/webhooks/inbound/nomba",
              {
                "group": "Endpoints",
                "pages": [
                  "api-reference/webhooks/endpoints/add",
                  "api-reference/webhooks/endpoints/all",
                  "api-reference/webhooks/endpoints/delete"
                ]
              },
              {
                "group": "Events",
                "pages": [
                  "api-reference/webhooks/events/catalog",
                  "api-reference/webhooks/events/all",
                  "api-reference/webhooks/events/deliveries"
                ]
              }
            ]
          },
          {
            "group": "Reconciliation",
            "pages": [
              "api-reference/reconciliation/index",
              "api-reference/reconciliation/discrepancies",
              "api-reference/reconciliation/resolve"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://orflow.vercel.app/dashboard",
          "icon": "external-link"
        },
        {
          "anchor": "Main Site",
          "href": "https://orflow.vercel.app",
          "icon": "globe"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://orflow.vercel.app"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hi@orflow.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://orflow.vercel.app/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Team-Blueprint/orflow-backend"
    }
  }
}